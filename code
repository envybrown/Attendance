/* This program will record the attendance by asking the user if each student in the vector
if present, with the result sorting the students into appropriate present and absent vectors. */

#include <iostream>
#include <string>
#include <vector>
#include <fstream>

using namespace std;

// function if line fails ask for new input
bool error();

// string of students in class
vector<string> students = {
    "Daryl Dixon", "Rick Grimes", "Carol Peletier", "Glenn Rhee", "Carl Grimes", "Gabriel Strokes",
	"Eugene Porter", "Morgan Jones", "Tara Chambler", "Shane Walsh"
};

// string for present students
vector<string> present = {};
// string for absent students
vector<string> absent = {};

int main()
{
    char attendance;
    int month;
    int day;
    int year;
    
    // ask for date
    cout << "MONTH?\n";
    while(true) { 
        cin >> month;
        
        if (error()) continue;
        if (month<1||month>12) {
        cout << "Invalid input. Please try again.\n";
        continue;
        }
        break;
    }

    cout << "DAY?\n";
    while(true) { 
        cin >> day;
        
        if (error()) continue;
        if (day<1||day>31) {
        cout << "Invalid input. Please try again.\n";
        continue;
        }
        break;
    }
    
    cout << "YEAR?\n";
        cin >> year;
 
    cout << "\n";
    
    // ask is student is present 
    for (int i=0; i<students.size(); i++) {
    cout << "IS " << students[i] << " PRESENT? (y/n)\n";
        
        // check if input is valid
        while(true) {
            cin >> attendance; 
            
            if (error()) continue;
            if (attendance!='y'&&attendance!='n'&&attendance!='Y'&&attendance!='N') { 
                cout << "Invalid input. Please try again.\n";
                continue;
            }
            break;
        }
        
        // sort present and absent students into vectors
        if (attendance=='y'||attendance=='Y') {
            present.push_back(students[i]);
        } else {
            absent.push_back(students[i]);
        }    
    }
    
    // report attendance
    cout << month << "/" << day << "/" << year;
    
    cout << "\nSTUDENTS PRESENT:\n\n";
    
    for (int i=0; i<present.size(); i++) {
        cout << present[i] << "\n";
    } 
    
    cout << "\nSTUDENTS ABSENT:\n\n";
    
    for (int i=0; i<absent.size(); i++) {
        cout << absent[i] << "\n";
    } 
    
    // write attendance to file
    ofstream myfile("attendance.txt");
    myfile << month << "/" << day << "/" << year << "\n\n";
    
	myfile << "STUDENTS PRESENT:\n\n";
    for (int i=0; i<present.size(); i++) {
        myfile << present[i] << "\n";
    }
    myfile << "\nSTUDENTS ABSENT:\n\n";
    for (int i=0; i<absent.size(); i++) {
        myfile << absent[i] << "\n";
    }
    myfile.close();
    
    return 0;
}

// error function definition 
bool error() {
	if (cin.fail()) {
		cin.clear();
		cin.ignore(1000, '\n');
		cout<<"Invalid input. Please try again.\n";
		return true;
	}
	return false;
}
