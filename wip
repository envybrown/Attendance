#include <iostream>
#include <string>
#include <vector>
#include <utility>

using namespace std;

// functions
    // if line fails ask for new input
bool error();

// string of students in class
vector<string> students = {
    "Ilyas Devaux", "Damon Diulio", "Hamir Griffith", "Anthony Landritsi", "Bode Lentz", "George Louglos", "Jordan Mckenzie", "Envy Brown",
    "Christopher Richter", "Caleb Roswell", "Seth Scott", "Ryan Seno", "Tiahna Spencer", "Bailin Stokes", "Elijah Verdaguer", "Connor Wentworth",
};

vector<string> present = {};
vector<string> absent = {};

int main()
{
    char attendance;
    
    for (int i=0; i<students.size(); i++) {
    cout << "IS " << students[i] << " PRESENT?\n";
    
        while(true) {
            cin >> attendance; 
            
            if (error()) continue;
            if (attendance!='y'&&attendance!='n'&&attendance!='Y'&&attendance!='N') { 
                cout << "Invalid input. Please try again.\n";
                continue;
            }
            break;
        }
        
        if (attendance=='y'||attendance=='Y') {
            present.push_back(move(students[i]));
        } else {
            absent.push_back(move(students[i]));
        }    
    }
    
    // report attendance
    cout << "\nSTUDENTS PRESENT:\n\n";
    
    for (int i=0; i<present.size(); i++) {
        cout << present[i] << "\n";
    } 
    
    cout << "\nSTUDENTS ABSENT:\n\n";
    
    for (int i=0; i<absent.size(); i++) {
        cout << absent[i] << "\n";
    } 
    
    
    return 0;
}

bool error() {
	if (cin.fail()) {
		cin.clear();
		cin.ignore(1000, '\n');
		cout<<"Invalid input. Please try again.\n";
		return true;
	}
	return false;
}
